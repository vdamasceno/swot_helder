Options -MultiViews
RewriteEngine On

# Se o arquivo existe, serve direto
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Tenta index.html (deploy via Hostinger/Linux)
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^ index.html [QSA,L]

# Fallback: _shell.html (build local Windows)
RewriteRule ^ _shell.html [QSA,L]
