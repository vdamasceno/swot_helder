Options -MultiViews
RewriteEngine On
RewriteBase /

# Serve static files directly (js, css, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# SPA fallback: try index.html first (Linux/Hostinger build)
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^ /index.html [QSA,L]

# SPA fallback: try _shell.html (Windows local build)
RewriteCond %{DOCUMENT_ROOT}/_shell.html -f
RewriteRule ^ /_shell.html [QSA,L]
